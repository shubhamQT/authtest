{
  "id": "create-lead-missing-lastname",
  "testPlanId": "7f6e9208-00aa-4978-bb68-f3bf0ca5a06c",
  "requirementId": "e2c92386-6845-43b3-a785-231aec138c14",
  "suiteName": "Create Lead - E2E",
  "case": {
    "id": "create-lead-missing-lastname",
    "title": "Attempt to create Lead without Last Name and verify validation error",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "step-1",
        "action": "openUrl",
        "targetDescription": "Navigate to Salesforce Leads tab",
        "value": "https://orgfarm-cdb7bbd1fc-dev-ed.develop.my.salesforce.com/lightning/o/Lead/list"
      },
      {
        "id": "step-2",
        "action": "tap",
        "targetDescription": "Click on the 'New' button",
        "locatorHint": "button[title='New']"
      },
      {
        "id": "step-3",
        "action": "fill",
        "targetDescription": "Enter First Name",
        "locatorHint": "input[name='FirstName']",
        "value": "John"
      },
      {
        "id": "step-4",
        "action": "fill",
        "targetDescription": "Enter Company",
        "locatorHint": "input[name='Company']",
        "value": "ABC Technologies"
      },
      {
        "id": "step-5",
        "action": "tap",
        "targetDescription": "Click on the 'Save' button",
        "locatorHint": "button[title='Save']"
      },
      {
        "id": "step-6",
        "action": "assertVisible",
        "targetDescription": "Verify validation error for Last Name",
        "locatorHint": ".errorsList li"
      },
      {
        "id": "step-7",
        "action": "assertContainsText",
        "targetDescription": "Check error message mentions Last Name",
        "locatorHint": ".errorsList li",
        "assertion": "Last Name"
      }
    ],
    "tags": [
      "@e2e",
      "@regression",
      "lead"
    ]
  }
}
